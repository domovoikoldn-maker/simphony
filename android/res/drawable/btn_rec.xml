<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#44FFFFFF">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="oval"><solid android:color="#FF2A1C1E" /></shape>
            </item>
            <item android:state_activated="true">
                <shape android:shape="oval"><solid android:color="@color/rec" /><stroke android:width="3dp" android:color="#FFFFFFFF" /></shape>
            </item>
            <item>
                <shape android:shape="oval"><solid android:color="#FF3A1E21" /><stroke android:width="2dp" android:color="@color/rec" /></shape>
            </item>
        </selector>
    </item>
</ripple>
