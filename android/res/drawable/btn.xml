<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33FFFFFF">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape><solid android:color="#FF18181D" /><corners android:radius="10dp" /><stroke android:width="1dp" android:color="#FF24242B" /></shape>
            </item>
            <item android:state_activated="true">
                <shape><solid android:color="#FF4A3A1C" /><corners android:radius="10dp" /><stroke android:width="1dp" android:color="@color/accent" /></shape>
            </item>
            <item>
                <shape><solid android:color="#FF26262E" /><corners android:radius="10dp" /><stroke android:width="1dp" android:color="@color/panel_line" /></shape>
            </item>
        </selector>
    </item>
</ripple>
